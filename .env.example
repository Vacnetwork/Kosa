# ---------------------------------------------------------------------------
# KOSA website — environment variables
#
# Copy to `.env.local` for development and set the same names in your host
# (Cloudflare Pages → Settings → Environment variables) for production.
#
# Only NEXT_PUBLIC_* values are visible in the browser. That is safe for the
# Supabase anon key and the Turnstile site key BY DESIGN. The service-role key,
# the Turnstile secret and the database password must NEVER be given a
# NEXT_PUBLIC_ name and must never be committed: this repo contains no secrets.
# ---------------------------------------------------------------------------

# Supabase project (free plan). Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Cloudflare Turnstile site key (public). The matching secret goes into
# Supabase → Authentication → Attack protection → Bot and abuse protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Canonical origin used for metadata, sitemap, robots and email redirects.
NEXT_PUBLIC_SITE_URL=https://kosa-website.pages.dev

# Optional: path to an official crest image if one is supplied later.
# NEXT_PUBLIC_CREST_SRC=/brand/kosa-crest.png

# ---------------------------------------------------------------------------
# Local tooling only — never expose these to the frontend, never commit them.
# ---------------------------------------------------------------------------
# Used by scripts that apply migrations/seed to the database.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=only-for-local-scripts
# Cloudflare deployment (wrangler). Scope: Pages:Edit for one account.
CLOUDFLARE_API_TOKEN=only-for-CI
CLOUDFLARE_ACCOUNT_ID=only-for-CI
